{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "West Build w6100-evb-pico",
			"type": "shell",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"linux": {
				"command": "bash",
				"args": [
					"-c",
					"source ${userHome}/zephyrproject/.venv/bin/activate && west build -p auto -b rpi_pico  -- -DRPI_PICO_DEBUG_ADAPTER=minimodule-swd -DOPENOCD=/usr/bin/openocd -DOPENOCD_DEFAULT_PATH=~/openocd/tcl -DCONF_FILE=prj.conf -DOVERLAY_CONFIG=boards/rpi_pico.conf"
					// "source ${userHome}/zephyrproject/.venv/bin/activate && west build -p auto -b rpi_pico --sysbuild -- -DRPI_PICO_DEBUG_ADAPTER=minimodule-swd -DOPENOCD=/usr/bin/openocd -DOPENOCD_DEFAULT_PATH=~/openocd/tcl -DCONF_FILE=prj.conf -DOVERLAY_CONFIG=boards/rpi_pico.conf"
				]
			},
			"windows": {
				"command": "cmd",
				"args": [
					"/c",
					"call %userHome%\\zephyrproject\\.venv\\Scripts\\activate && west build -p auto -b rpi_pico --sysbuild -- -DRPI_PICO_DEBUG_ADAPTER=minimodule-swd -DOPENOCD=/usr/bin/openocd -DOPENOCD_DEFAULT_PATH=~/openocd/tcl -DCONF_FILE=prj.conf -DOVERLAY_CONFIG=boards/rpi_pico.conf"
				]
			},
			"osx": {
				"command": "bash",
				"args": [
					"-c",
					"source ${userHome}/.local/.venv/bin/activate && west build -p auto -b rpi_pico --sysbuild -- -DRPI_PICO_DEBUG_ADAPTER=minimodule-swd -DOPENOCD=/usr/bin/openocd -DOPENOCD_DEFAULT_PATH=~/openocd/tcl -DCONF_FILE=prj.conf -DOVERLAY_CONFIG=boards/rpi_pico.conf"
				]
			},
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "West Build rpi-pico-w",
			"type": "shell",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"linux": {
				"command": "bash",
				"args": [
					"-c",
					"source ${userHome}/zephyrproject/.venv/bin/activate && west build -p auto -b rpi_pico/rp2040/w --sysbuild -- -DRPI_PICO_DEBUG_ADAPTER=minimodule-swd -DOPENOCD=/usr/bin/openocd -DOPENOCD_DEFAULT_PATH=~/openocd/tcl -DCONF_FILE=prj.conf -DOVERLAY_CONFIG=boards/rpi_pico_rp2040_w.conf"
				]
			},
			"windows": {
				"command": "cmd",
				"args": [
					"/c",
					"call %userHome%\\zephyrproject\\.venv\\Scripts\\activate && west build -p auto -b rpi_pico/rp2040/w --sysbuild -- -DRPI_PICO_DEBUG_ADAPTER=minimodule-swd -DOPENOCD=/usr/bin/openocd -DOPENOCD_DEFAULT_PATH=~/openocd/tcl -DCONF_FILE=prj.conf -DOVERLAY_CONFIG=boards/rpi_pico_rp2040_w.conf"
				]
			},
			"osx": {
				"command": "bash",
				"args": [
					"-c",
					"source ${userHome}/.local/.venv/bin/activate && west build -p auto -b rpi_pico/rp2040/w --sysbuild -- -DRPI_PICO_DEBUG_ADAPTER=minimodule-swd -DOPENOCD=/usr/bin/openocd -DOPENOCD_DEFAULT_PATH=~/openocd/tcl -DCONF_FILE=prj.conf -DOVERLAY_CONFIG=boards/rpi_pico_rp2040_w.conf"
				]
			},
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "West Build esp32s3",
			"type": "shell",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"linux": {
				"command": "bash",
				"args": [
					"-c",
					// "source ${userHome}/zephyrproject/.venv/bin/activate && west build -p auto -b esp32s3_devkitc/esp32s3/procpu -S psram-8M -S psram-wifi -S flash-16M -- -DCONF_FILE=prj.conf -DOVERLAY_CONFIG=boards/esp32s3_devkitc.conf -DDTC_OVERLAY_FILE=boards/esp32s3_devkitc.overlay"
					"source ${userHome}/zephyrproject/.venv/bin/activate && west build -p auto -b esp32s3_devkitc/esp32s3/procpu -S flash-16M -- -DCONF_FILE=prj.conf -DOVERLAY_CONFIG=boards/esp32s3_devkitc.conf -DDTC_OVERLAY_FILE=boards/esp32s3_devkitc.overlay"
					// "source ${userHome}/zephyrproject/.venv/bin/activate && west build -p auto -b esp32s3_devkitc/esp32s3/procpu -S psram-2M -S psram-wifi -S flash-8M -- -DCONF_FILE=prj.conf -DOVERLAY_CONFIG=boards/esp32s3_devkitc.conf -DDTC_OVERLAY_FILE=boards/esp32s3_devkitc.overlay"
				]
			},
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "West Flash",
			"type": "shell",
			"linux": {
				"command": "bash",
				"args": [
					"-c",
					"source ${userHome}/zephyrproject/.venv/bin/activate && west flash"
				]
			},
			"windows": {
				"command": "cmd",
				"args": [
					"/c",
					"call %userHome%\\zephyrproject\\.venv\\Scripts\\activate && west flash"
				]
			},
			"osx": {
				"command": "bash",
				"args": [
					"-c",
					"source ${userHome}/.local/.venv/bin/activate && west flash"
				]
			},
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "w6100-evb-pico",
			"dependsOrder": "sequence",
			"dependsOn": [
				"West Build w6100-evb-pico",
				"West Flash"
			]
		},
		{
			"label": "rpi-pico-w",
			"dependsOrder": "sequence",
			"dependsOn": [
				"West Build rpi-pico-w",
				"West Flash"
			]
		},
		{
			"label": "esp32s3 build flash",
			"dependsOrder": "sequence",
			"dependsOn": [
				"West Build esp32s3",
				"West Flash"
			]
		},
	],
	"inputs": [
		{
			"id": "board",
			"type": "promptString",
			"default": "nucleo_g474re",
			"description": "See https://docs.zephyrproject.org/latest/boards/index.html"
		},
		{
			"id": "pristine",
			"type": "pickString",
			"description": "Choose when to run a pristine build",
			"default": "auto",
			"options": [
				"auto",
				"always",
				"never"
			]
		}
	]
}
